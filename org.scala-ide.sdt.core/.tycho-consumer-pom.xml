                <configuration>
                  <outputDirectory>${project.build.directory}/lib</outputDirectory>
                  <artifactItems>
                    <artifactItem>
                      <groupId>org.scala-lang.modules</groupId>
                      <artifactId>scala-parallel-collections_${scala.minor.version}</artifactId>
                      <version>${scala.parallel-collections.version}</version>
                    </artifactItem>
                  </artifactItems>
                </configuration>
              </execution>
            </executions>
